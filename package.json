{
  "name": "liame",
  "productName": "Liame",
  "version": "0.2.1",
  "license": "MIT",
  "author": "Adam Krupa",
  "homepage": "https://github.com/pcstyle-os/liame#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pcstyle-os/liame.git"
  },
  "bugs": {
    "url": "https://github.com/pcstyle-os/liame/issues"
  },
  "keywords": [
    "electron",
    "email",
    "mail-client",
    "imap",
    "smtp",
    "macos",
    "oled",
    "react"
  ],
  "engines": {
    "bun": ">=1.4.0"
  },
  "description": "A quiet, OLED-dark mail client for macOS.",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "dist": "electron-vite build && electron-builder --mac --arm64 -c.mac.identity=\"$(sh scripts/sign-identity.sh)\""
  },
  "trustedDependencies": [
    "electron",
    "esbuild"
  ],
  "dependencies": {
    "imapflow": "^2.10.2",
    "mailparser": "^3.14.2",
    "nodemailer": "^10.3.1"
  },
  "devDependencies": {
    "@ai-sdk/openai": "^4.0.109",
    "@ai-sdk/typesafe-ai": "^3.0.34",
    "@types/mailparser": "^3.9.0",
    "@types/node": "^26.6.6",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "ai": "^7.0.163",
    "ai-sdk-provider-codex-cli": "^2.4.0",
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "lucide-react": "^1.69.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.6",
    "zod": "^4.6.7"
  },
  "build": {
    "appId": "dev.pcstyle.liame",
    "productName": "Liame",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "out/**",
      "package.json"
    ],
    "npmRebuild": false,
    "mac": {
      "target": [
        "dir"
      ],
      "icon": "build/icon.icns",
      "category": "public.app-category.productivity",
      "identity": "-",
      "darkModeSupport": true,
      "extendInfo": {
        "NSUserNotificationAlertStyle": "banner"
      },
      "hardenedRuntime": false
    }
  }
}
